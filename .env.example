# Local gateway configuration. The playable app currently uses scripted coworkers.
# Optional local overrides load from .env.local; no key is needed for the offline mission.
# Never put a real key in this committed file or a VITE_ variable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
LLM_MODE=scripted
HOST=127.0.0.1
PORT=4173
LLM_MAX_INPUT_TOKENS=6000
LLM_COWORKER_MAX_OUTPUT_TOKENS=400
LLM_DEBRIEF_MAX_OUTPUT_TOKENS=800
LLM_MAX_CALLS_PER_INTERACTION=3
LLM_MAX_CALLS_PER_MISSION=24
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_COWORKER_CALL_TIMEOUT_MS=8000
LLM_INTERACTION_TIMEOUT_MS=18000
LLM_DEBRIEF_TIMEOUT_MS=20000
LLM_SDK_MAX_RETRIES=0
# Proposed application API allowance. Not a provider-side billing cap.
# The gateway must persist accounting across resets and restarts.
LLM_SESSION_BUDGET_USD=5
LLM_USAGE_LEDGER_PATH=.local/usage.json
