# Local gateway configuration. Scripted mode needs no credentials.
# Optional local overrides load from .env.local; no key is needed for the offline mission.
# Never put a real key in this committed file or a VITE_ variable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-terra
OPENAI_REASONING_EFFORT=low
# Custom models require both USD-per-million prices; include the cache-write ceiling.
# OPENAI_INPUT_USD_PER_MILLION=1.25
# OPENAI_OUTPUT_USD_PER_MILLION=5
LLM_MODE=scripted
PORT=4173
# Fixed code limits: 6000 planned input tokens; 400/800 output tokens;
# 3 calls per interaction, 24 per mission, one provider call at a time;
# 8s call / 18s interaction / 20s debrief timeouts; no SDK retries.
# Local API allowance; not a provider-side billing cap. Persisted across resets/restarts.
LLM_SESSION_BUDGET_USD=5
LLM_USAGE_LEDGER_PATH=.local/usage.json
